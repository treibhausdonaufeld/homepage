---
import Email from './Email.astro';
import { MATRIX_ROOM, MATRIX_URL } from '../lib/i18n';
interface Props { lang?: 'de' | 'en' }
const { lang = 'de' } = Astro.props;
const de = lang === 'de';
---
<section class="band" id="hallo" aria-labelledby="hallo-h">
  <div class="wrap grid">
    <div>
      <h2 id="hallo-h" class="big">{de ? 'Sag hallo.' : 'Say hello.'}</h2>
      <p class="lead">{de ? 'Fragen, Ideen, Lob, Beschwerden – schreib uns im offenen Chat-Raum vom Treibhaus.' : 'Questions, ideas, praise, complaints – write to us in the open chat room of the Treibhaus.'}</p>
      <p class="row">
        <a class="btn light" href={MATRIX_URL}>{de ? 'Im Matrix-Raum hallo sagen' : 'Say hello on Matrix'}</a>
        <span class="small">{MATRIX_ROOM}</span>
      </p>
      <p>{de ? 'Oder per Mail:' : 'Or by email:'} <Email strong /></p>
    </div>
    <div class="howto">
      <h3>{de ? 'Noch nie von Matrix gehört?' : 'Never heard of Matrix?'}</h3>
      <p>{de ? 'Matrix ist ein freier Chat – wie WhatsApp, nur ohne Konzern dahinter. So kommst du rein:' : 'Matrix is a free chat – like WhatsApp, but without a corporation behind it. How to join:'}</p>
      <ol>
        <li>{de ? 'Auf den Knopf klicken.' : 'Click the button.'}</li>
        <li>{de ? '„Element“ wählen – geht auch im Browser.' : 'Choose “Element” – works in the browser too.'}</li>
        <li>{de ? 'Konto anlegen (eine Minute) und losschreiben.' : 'Create an account (one minute) and start writing.'}</li>
      </ol>
    </div>
  </div>
</section>
<style>
  .band { background: var(--band); color: var(--on-band); padding: 72px 0; }
  .band :global(a:not(.btn)) { color: var(--on-band); }
  .grid { display: grid; gap: 40px 64px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); align-items: start; }
  .big { font-size: clamp(48px, 7vw, 80px); letter-spacing: -0.035em; margin-bottom: 16px; }
  .lead { color: var(--on-band-2); }
  .howto { border-left: 2px solid var(--on-band-2); padding-left: 28px; color: var(--on-band-2); font-size: 16px; }
  .howto h3 { color: var(--on-band); font-size: 18px; }
  .howto ol { padding-left: 1.2em; margin: 0; }
</style>
