---
import type { PublicEvent } from '../lib/booking/types';
import { CATEGORY_LABEL, type Category } from '../lib/booking/types';
import { fmt, localParts } from '../lib/time';
interface Props { events: PublicEvent[]; showAdd?: boolean }
const { events, showAdd = false } = Astro.props;
---
<ul class="events">
  {events.map((e) => (
    <li>
      <div class="date" aria-hidden="true">
        <span class="d">{localParts(e.start).day}</span>
        <span class="m">{fmt.wdShort(e.start)} · {fmt.monShort(e.start)}</span>
      </div>
      <div class="what">
        <h3>{e.offer ? <a href={`/angebote/${e.offer}`}>{e.title}</a> : e.title}</h3>
        <p class="muted small"><span class="sr-only">{fmt.long(e.start)}, </span>{fmt.range(e.start, e.end)} · {e.roomName}</p>
      </div>
      {e.category && <span class="cat">{CATEGORY_LABEL[e.category as Category] ?? e.category}</span>}
    </li>
  ))}
  {showAdd && (
    <li>
      <div class="date plus" aria-hidden="true">+</div>
      <div class="what">
        <h3>Dein Angebot?</h3>
        <p class="muted small">Kochabend, Spieletreff, Kurs – der Saal und die Küche sind noch oft frei. <a href="/anbieten">So geht’s</a></p>
      </div>
    </li>
  )}
</ul>
<style>
  .events { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .events li { display: flex; gap: 20px; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .date { width: 64px; flex: none; text-align: center; line-height: 1; }
  .date .d { display: block; font-size: 36px; font-weight: 800; letter-spacing: -0.02em; }
  .date .m { display: block; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin-top: 4px; }
  .date.plus { font-size: 24px; color: var(--muted); }
  .what { flex: 1; min-width: 0; }
  .what h3 { font-size: 18px; margin: 0 0 2px; letter-spacing: 0; }
  .what h3 a { color: var(--ink); text-decoration: none; }
  .what h3 a:hover { text-decoration: underline; }
  .what p { margin: 0; }
  @media (max-width: 520px) { .cat { display: none; } }
</style>
