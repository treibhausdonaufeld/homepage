---
/** Text mit gelb markierten offenen Punkten: „[TODO: …]“ → <mark class="todo">. */
interface Props { text?: string | null }
const { text = '' } = Astro.props;
const parts = (text ?? '').split(/\[(TODO[^\]]*|prüfen)\]/g);
---
{parts.map((p, i) => (i % 2 === 1 ? <mark class="todo">{p}</mark> : p))}
