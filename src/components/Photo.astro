---
/** Foto oder – solange es keins gibt – ein beschrifteter Platzhalter. */
interface Props { src?: string; alt: string; ratio?: string; tilt?: number; class?: string }
const { src, alt, ratio = '4/3', tilt = 0, class: cls = '' } = Astro.props;
const style = `aspect-ratio:${ratio};${tilt ? `transform:rotate(${tilt}deg);` : ''}`;
---
{src ? (
  <img class={`photo ${cls}`} src={src} alt={alt} style={style} loading="lazy" />
) : (
  <div class={`ph photo ${cls}`} style={style} role="img" aria-label={`Platzhalter für Foto: ${alt}`}>FOTO: {alt}</div>
)}
<style>
  .photo { width: 100%; object-fit: cover; border: 10px solid var(--surface); box-shadow: 0 2px 10px rgb(0 0 0 / 0.12); }
</style>
