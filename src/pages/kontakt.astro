---
import Email from '../components/Email.astro';
import Base from '../layouts/Base.astro';
import SagHallo from '../components/SagHallo.astro';
---
<Base title="Kontakt & Anfahrt" description="So erreichst du das Treibhaus Donaufeld: Matrix-Raum #hallo, E-Mail, Adresse und Anfahrt." alternate="/en/contact">
  <section class="wrap section">
    <h1>Kontakt & Anfahrt</h1>
    <p class="lead">Am schnellsten erreichst du uns im offenen Matrix-Raum <strong>#hallo</strong>. Dort lesen viele aus dem Haus mit.</p>
  </section>
  <SagHallo />
  <section class="wrap section grid-2" id="anfahrt">
    <div>
      <h2>Simone-Veil-Gasse 7, 1210 Wien</h2>
      <ul class="ways">
        <li><strong>Mit dem Rad:</strong> am besten über den Radhighway Reichsbrücke.</li>
        <li><strong>Straßenbahn:</strong> Linie 25 bis Prandaugasse (5–10 Minuten zu Fuß) oder 25/26 bis Carminweg.</li>
        <li><strong>U-Bahn:</strong> U1 bis Kagran, dann ca. 15 Minuten zu Fuß.</li>
        <li>Die Alte Donau und der Badeplatz sind in Gehweite.</li>
      </ul>
      <p><a href="https://www.openstreetmap.org/search?query=Simone-Veil-Gasse%207%2C%201210%20Wien">Auf OpenStreetMap öffnen</a></p>
      <h2 style="margin-top:32px">Schreiben</h2>
      <ol>
        <li><strong>Matrix:</strong> <a href="https://matrix.to/#/%23hallo:treibhausdonaufeld.at">#hallo:treibhausdonaufeld.at</a></li>
        <li><strong>E-Mail:</strong> <Email /></li>
      </ol>
      <p class="small muted">Für WG-Anfragen bitte den Betreff „WG“ verwenden.</p>
    </div>
    <div>
      <img src="/images/karte.svg" alt="Skizze: Das Treibhaus in der Simone-Veil-Gasse 7, zwischen den Straßenbahnhaltestellen Prandaugasse (25) und Carminweg (25/26)." width="560" height="320" style="width:100%;border:1px solid var(--line);border-radius:4px" />
      <p class="small"><mark class="todo">TODO: statischen OpenStreetMap-Ausschnitt einsetzen</mark></p>
    </div>
  </section>
</Base>
<style>.ways { padding-left: 1.2em; } .ways li { margin: 6px 0; }</style>
