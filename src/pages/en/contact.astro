---
import Base from '../../layouts/Base.astro';
import SagHallo from '../../components/SagHallo.astro';
---
<Base title="Contact" lang="en" alternate="/kontakt">
  <section class="wrap section">
    <h1>Contact & directions</h1>
    <p class="lead">The quickest way to reach us is the open Matrix room <strong>#hallo</strong>.</p>
  </section>
  <SagHallo lang="en" />
  <section class="wrap section">
    <h2>Simone-Veil-Gasse 7, 1210 Vienna</h2>
    <ul>
      <li><strong>By bike:</strong> best via the Reichsbrücke cycle highway.</li>
      <li><strong>Tram:</strong> line 25 to Prandaugasse, or 25/26 to Carminweg.</li>
      <li><strong>Underground:</strong> U1 to Kagran, then about 15 minutes on foot.</li>
    </ul>
  </section>
</Base>
