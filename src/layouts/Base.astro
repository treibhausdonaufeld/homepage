---
import '@fontsource-variable/kumbh-sans';
// Schrift vorladen, damit beim Seitenwechsel nicht erst die Ersatzschrift erscheint.
import fontUrl from '@fontsource-variable/kumbh-sans/files/kumbh-sans-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Lang } from '../lib/i18n';
import { HEAD_SCRIPT } from '../lib/head-script';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  noindex?: boolean;
  /** Ohne Header/Footer (z. B. Buchungsschritte) */
  bare?: boolean;
  alternate?: string;
}
const { title, description = 'Ein offenes Haus fürs Donaufeld: Viertelsaal und Viertelküche für Nachbar:innen, offene Angebote und Raumbuchung ohne Konto.', lang = 'de', noindex = false, bare = false, alternate } = Astro.props;
const fullTitle = title.includes('Treibhaus') ? title : `${title} – Treibhaus Donaufeld`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <!-- Gespeichertes Farbschema und js-Klasse sofort setzen (siehe lib/head-script.ts). -->
    <script is:inline set:html={HEAD_SCRIPT}></script>
    <!-- Hintergrund sofort setzen, bevor das Stylesheet geladen ist: verhindert weißes Aufblitzen beim Seitenwechsel (v. a. im Dunkelmodus). -->
    <style is:inline>
      html { background: #faf8f3; color-scheme: light; }
      html[data-theme='dark'] { background: #151410; color-scheme: dark; }
      @media (prefers-color-scheme: dark) {
        html:not([data-theme='light']) { background: #151410; color-scheme: dark; }
      }
    </style>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternate && <link rel="alternate" hreflang={lang === 'de' ? 'en' : 'de'} href={new URL(alternate, Astro.site)} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#5D7A10" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/images/favicon-192x192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="alternate" type="text/calendar" title="Termine (iCal)" href="/termine.ics" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline src="/js/theme.js" defer></script>
    <script is:inline src="/js/email.js" defer></script>
  </head>
  <body>
    <a class="skip" href="#inhalt">{t[lang].skip}</a>
    {!bare && <Header lang={lang} />}
    <main id="inhalt">
      <slot />
    </main>
    {!bare && <Footer lang={lang} />}
    <slot name="scripts" />
  </body>
</html>
