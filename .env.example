# Kopieren nach .env und ausfüllen. Werte ohne Angabe haben sinnvolle Standards (siehe src/lib/config.ts).

# Öffentliche Adresse (für Links in Mails und Matrix)
PUBLIC_URL=https://treibhausdonaufeld.at
SITE_ADDRESS=treibhausdonaufeld.at

# Geheimnisse – jeweils z. B. mit `openssl rand -base64 32` erzeugen
HMAC_SECRET=
SESSION_SECRET=

# Produktion: Entwicklungs-Login ausschalten
DEV_ADMIN_LOGIN=false

# SMTP des Hauses
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Treibhaus Donaufeld <hallo@treibhausdonaufeld.at>

# Matrix-Bot @raeume:treibhausdonaufeld.at
MATRIX_HOMESERVER=https://matrix.treibhausdonaufeld.at
MATRIX_BOT_TOKEN=

# Rocket.Chat-Bot (Benutzer-ID und persönliches Zugangstoken).
# Wohin Meldungen gehen (Channel, Matrix-Raum, E-Mail), stellt die Raum-AG im Admin ein.
ROCKETCHAT_URL=
ROCKETCHAT_USER_ID=
ROCKETCHAT_TOKEN=

# Login der Raum-AG über Authentik
OIDC_ISSUER=https://auth.treibhausdonaufeld.at/application/o/website/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ADMIN_GROUP=raum-ag

# Newsletter (listmonk, öffentliche Abo-Schnittstelle)
LISTMONK_URL=
LISTMONK_LIST_UUIDS=

# Platzhalter für Entscheidungen der Hausgemeinschaft
HOLD_HOURS=72
CODE_TTL_MINUTES=30
RETENTION_MONTHS=6
RESPONSE_TIME_TEXT=3 Werktagen
TRUST_AFTER_APPROVALS=0

# Backup (Profil „backup“)
LITESTREAM_BUCKET=treibhaus-backup
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
